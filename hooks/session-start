#!/usr/bin/env bash
# SessionStart hook for jev-superpowers-zh plugin
#
# 以 superpowers-zh 版为基座（Cursor / Claude / Copilot / Muse 四平台输出分支），
# 注入 jev-using-superpowers/SKILL.md 全文，并追加动态门禁就绪段：
#   - 项目 = agent 启动目录（$PWD），经 scripts/jev-readiness --json 取 state；
#   - notified=false：完整段（四态/后端/缺失工具+安装命令/strict/指引），随后置位；
#   - notified=true ：一行精简状态（每会话仅完整提示一次）；
#   - 就绪段生成失败一律空段兜底，绝不破坏注入 JSON 的合法性。
# 依据：spec §5.4、§5.2。

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read jev-using-superpowers content (the Jev router, not the non-Jev original)
using_superpowers_content=$(cat "${PLUGIN_ROOT}/skills/jev-using-superpowers/SKILL.md" 2>&1 || echo "Error reading jev-using-superpowers skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# ---------------------------------------------------------------------------
# 动态门禁就绪段（任何失败 → 空字符串，不影响整体 JSON 输出）
# ---------------------------------------------------------------------------
readiness_section=""
PROJECT_DIR="${PWD:-.}"
state_json=""
if state_json="$(bash "$PLUGIN_ROOT/scripts/jev-readiness" --project "$PROJECT_DIR" --json 2>/dev/null)"; then
  :
else
  state_json=""
fi

if [ -n "$state_json" ]; then
  notified_flag="$(printf '%s' "$state_json" | node -e '
    let s="";
    process.stdin.on("data", d => s += d);
    process.stdin.on("end", () => {
      try { process.stdout.write(JSON.parse(s).notified === true ? "1" : "0"); }
      catch (e) { process.stdout.write(""); }
    });
  ' 2>/dev/null || true)"

  case "$notified_flag" in
    1) section_mode="compact" ;;
    0) section_mode="full" ;;
    *) section_mode="" ;;
  esac

  if [ -n "$section_mode" ]; then
    section_text="$(STATE_JSON="$state_json" SECTION_MODE="$section_mode" node -e '
      let j;
      try { j = JSON.parse(process.env.STATE_JSON); } catch (e) { process.exit(1); }
      const state = String(j.state || "");
      if (process.env.SECTION_MODE === "compact") {
        process.stdout.write("\n\n---\n门禁状态：" + state + "（本会话已提示；运行 jev-readiness 查看详情）");
        process.exit(0);
      }
      const hints = {
        "jev-scout": "cargo install jev-scout",
        "jev-axi": "npm install -g jev-axi",
        "git-jev": "git jev install",
        "jev-guard": "npm install -g jev-guard",
        "supercov": "npm install -g supercov",
        "limpet": "cargo install limpet"
      };
      const missing = Array.isArray(j.missingTools) ? j.missingTools : [];
      const lines = [];
      lines.push("");
      lines.push("---");
      lines.push("## 本会话门禁状态（jev-superpowers-zh）");
      lines.push("- 总体状态：" + state);
      lines.push("- 后端：" + String(j.backend || "unknown"));
      if (missing.length > 0) {
        lines.push("- 缺失工具：" + missing.map(t => t + "（安装：" + (hints[t] || "见 jev-readiness 报告") + "）").join("、"));
      } else {
        lines.push("- 缺失工具：无");
      }
      lines.push("- 严格模式：" + (j.strict === true
        ? "开启（环境型失败将以 exit 2 阻断）"
        : "关闭（环境型失败软降级并转标准中文技能；JEVZH_STRICT=1 可开启）"));
      lines.push("- 提示：运行 jev-readiness 可查看完整报告与安装命令；缺失的门软降级转标准中文技能，不代表门禁已通过。");
      process.stdout.write(lines.join("\n"));
    ' 2>/dev/null || true)"

    if [ -n "$section_text" ]; then
      readiness_section="$section_text"
      # 完整提示每会话仅一次：仅在完整段渲染成功后置位 notified（失败忽略）。
      if [ "$section_mode" = "full" ]; then
        bash "$PLUGIN_ROOT/scripts/jev-readiness" --project "$PROJECT_DIR" \
          --cached --mark-notified >/dev/null 2>&1 || true
      fi
    fi
  fi
fi

using_superpowers_escaped=$(escape_for_json "$using_superpowers_content")
section_escaped=$(escape_for_json "$readiness_section")
session_context="<EXTREMELY_IMPORTANT>\nYou have superpowers.\n\n**Below is the full content of your 'jev-using-superpowers' skill - your Jev-gated introduction. For all other skills, use the 'Skill' tool:**\n\n${using_superpowers_escaped}\n</EXTREMELY_IMPORTANT>${section_escaped}"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
# Muse sets MUSE_PLUGIN_ROOT and expects additionalContext (SDK standard).
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI/MUSE_PLUGIN_ROOT
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  # Muse sets MUSE_PLUGIN_ROOT — try Claude-style nested output for Muse Spark
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
