#!/usr/bin/env bash
# Stop-hook verification gate — jev-superpowers-zh 软降级版
#
# 三段检查：
#   1. 工作区有未提交变更（git status --porcelain 非空）
#   2. ./scripts/test.sh 存在且执行失败
#   3. limpet 收束门（经 scripts/jev-gate limpet）
# 前两段仅在 git 仓库内执行，属环境/执行状态：strict 中文 stderr + exit 2，
# soft 降级为 WARN + 继续。limpet 门始终执行：判定型否决（limpet 可用但结论
# 否决）即使 soft 也 exit 2；limpet 环境缺失时由 jev-gate 按 strict/soft 分流。
# strict/soft 读就绪缓存（--cached，stop 频繁触发）；解析失败按 soft——
# fail-open 仅适用于前两段本地状态检查，limpet 门由 jev-gate 自行判定。
#
# S-3：strict 不再命中第一个就退出——依次跑完三段，收集全部命中项后统一
# stderr 输出一次并 exit 2（soft 的逐条 WARN 聚合现状不变）。
# S-1：limpet 门经 30s 超时包装：超时属环境型——soft WARN exit 0，strict exit 2
# （正常返回的 limpet 判定型否决在任何模式下仍 exit 2）。
# 依据：spec §5.4、§4.3。
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECT_DIR="${PWD:-.}"

# ---------------------------------------------------------------------------
# 跨平台超时包装（S-1）：优先 timeout（Git for Windows / Linux 自带），
# 其次 gtimeout（macOS coreutils），都没有则裸执行（保持现状）。
# JEVZH_HOOK_TIMEOUT（秒）可覆盖默认阈值，仅供宿主自调/测试加速。
# 用法：run_to <秒> <命令...>；超时返回 124（被 -9 收割时 137）。
# ---------------------------------------------------------------------------
JEVZH_TIMEOUT_BIN=""
if command -v timeout >/dev/null 2>&1; then
    JEVZH_TIMEOUT_BIN="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
    JEVZH_TIMEOUT_BIN="gtimeout"
fi
run_to() {
    local secs="$1"; shift
    [ -n "${JEVZH_HOOK_TIMEOUT:-}" ] && secs="$JEVZH_HOOK_TIMEOUT"
    if [ -n "$JEVZH_TIMEOUT_BIN" ]; then
        "$JEVZH_TIMEOUT_BIN" "$secs" "$@"
    else
        "$@"
    fi
}
# 本地缓存读取专用：固定上限，不吃 JEVZH_HOOK_TIMEOUT（该变量是给「可能挂起
# 的外部探测/门」用的；冷盘上 --cached 本身可能要 1~2s，被测试加速值误杀会让
# strict 口径静默退化成 soft）。
run_to_fixed() {
    local secs="$1"; shift
    if [ -n "$JEVZH_TIMEOUT_BIN" ]; then
        "$JEVZH_TIMEOUT_BIN" "$secs" "$@"
    else
        "$@"
    fi
}
is_timeout_rc() { [ "$1" = "124" ] || [ "$1" = "137" ]; }

# limpet 门实际生效的超时秒数（仅用于对外文案；run_to 内部自行解析覆盖）。
LIMPET_TIMEOUT_SECS="${JEVZH_HOOK_TIMEOUT:-30}"

state_json=""
state_rc=0
# 注意：不可用 `if ! x=$(...); then rc=$?` —— `!` 会把 $? 重置为取反后的 0。
state_json="$(run_to_fixed 30 bash "$PLUGIN_ROOT/scripts/jev-readiness" --project "$PROJECT_DIR" --json --cached 2>/dev/null)" || state_rc=$?
if is_timeout_rc "$state_rc"; then
    echo "WARN stop：jev-readiness 缓存读取超时（30s），strict 状态按 soft 处理。" >&2
fi
STRICT="$(printf '%s' "$state_json" | node -e '
  let s="";
  process.stdin.on("data", d => s += d);
  process.stdin.on("end", () => {
    try { process.stdout.write(JSON.parse(s).strict === true ? "1" : "0"); }
    catch (e) { process.stdout.write("0"); }
  });
' 2>/dev/null || true)"
[ "$STRICT" = "1" ] || STRICT=0

IN_REPO=0
if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    IN_REPO=1
fi

# 本地状态类问题收集（S-3）：
#   soft：逐条 WARN 后继续（保持原聚合行为）；
# strict：只收集不退出，三段跑完统一输出并 exit 2。
PROBLEM_COUNT=0
PROBLEM_LIST=""
note_local_problem() { # $1=中文说明
    if [ "$STRICT" = "1" ]; then
        PROBLEM_COUNT=$((PROBLEM_COUNT + 1))
        PROBLEM_LIST="${PROBLEM_LIST}  - $1"$'\n'
    else
        echo "WARN stop：$1（软降级放行，不代表检查通过）。" >&2
    fi
}

if [ "$IN_REPO" = "1" ]; then
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        note_local_problem "工作区仍有未提交变更，请先提交或 stash 后再结束"
    fi

    if [ -f "./scripts/test.sh" ]; then
        if ! bash ./scripts/test.sh >/dev/null 2>&1; then
            note_local_problem "./scripts/test.sh 执行失败，请先修复后再结束"
        fi
    fi
fi

# limpet 收束门：经 jev-gate 执行（S-1：30s 封顶）。判定否决（含 soft）一律
# exit 2；环境缺失 soft 时 jev-gate 已打印 [门禁降级] 并 exit 0。
LIMPET_TIMED_OUT=0
out="$(run_to 30 bash "$PLUGIN_ROOT/scripts/jev-gate" --project "$PROJECT_DIR" limpet 2>&1)"
rc=$?
printf '%s\n' "$out"

if is_timeout_rc "$rc"; then
    LIMPET_TIMED_OUT=1
    if [ "$STRICT" = "1" ]; then
        PROBLEM_COUNT=$((PROBLEM_COUNT + 1))
        PROBLEM_LIST="${PROBLEM_LIST}  - limpet 收束门禁超时（${LIMPET_TIMEOUT_SECS}s 无响应，按环境型失败处理）"$'\n'
    else
        echo "WARN stop：limpet 收束门禁超时（${LIMPET_TIMEOUT_SECS}s），软降级放行（环境型失败，不代表检查通过）。" >&2
    fi
elif [ "$rc" -ne 0 ]; then
    if [ "$STRICT" = "1" ]; then
        PROBLEM_COUNT=$((PROBLEM_COUNT + 1))
        PROBLEM_LIST="${PROBLEM_LIST}  - limpet 收束门禁未通过（详见上方 jev-gate 输出）"$'\n'
    else
        # soft 下 limpet 判定型否决仍不软放行
        echo "stop：limpet 收束门禁未通过（exit 2），结束被阻止；详见上方 jev-gate 输出。" >&2
        exit 2
    fi
fi

# S-3：strict 汇总本次所有命中项，统一输出一次。
if [ "$STRICT" = "1" ] && [ "$PROBLEM_COUNT" -gt 0 ]; then
    {
        echo "stop：严格模式下发现 ${PROBLEM_COUNT} 项阻断问题（exit 2），请逐项处理后再结束："
        printf '%s' "$PROBLEM_LIST"
    } >&2
    exit 2
fi

exit 0
